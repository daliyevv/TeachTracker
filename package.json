{
  "name": "teachtracker---sun'iy-intellekt-tekshiruvi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:unit && npm run test:rules",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:rules": "env -u JAVA_TOOL_OPTIONS firebase emulators:exec --only firestore,storage --project teachtracker-rules-test \"node --test tests/*.test.mjs\""
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "12.10.0",
    "framer-motion": "^12.34.5",
    "jose": "^6.2.12",
    "lucide-react": "^0.576.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "stripe": "^20.4.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.32.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
